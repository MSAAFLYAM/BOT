# ════════════════════════════════════════════════════════════════
# .env.example — Amazon Affiliate Bot for Hugging Face Spaces
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# On Hugging Face Spaces, set these in Settings → Secrets.
# NEVER commit .env to Git!

# ── Telegram (REQUIRED) ──────────────────────────────────────
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=@your_channel_username
ADMIN_CHAT_ID=your_telegram_user_id

# ── Webhook Security ─────────────────────────────────────────
# Random string to protect your webhook endpoint
WEBHOOK_SECRET=change_me_to_random_string

# ── AI Text Generation (OpenRouter) ──────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Image Processing ─────────────────────────────────────────
REMOVEBG_API_KEY=
REPLICATE_API_TOKEN=
IMGBB_API_KEY=

# ── Image Transformation (avoid copyright detection) ──────────
# Options: "auto", "oil_painting", "watercolor", "sketch", "vintage", "soft_glow", "none"
IMAGE_TRANSFORM_PRESET=auto
# Set to "0" to disable image transformation completely
IMAGE_TRANSFORM_ENABLED=1

# ── Google Sheets (optional) ─────────────────────────────────
GOOGLE_SHEET_NAME=Amazon Bot
JSON_FILE=amazon-bot.json

# ── Pinterest ────────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD=Amazon Deals
PINTEREST_DAILY_CAP=5
PINTEREST_HOURS_AHEAD=4

# ── Amazon Affiliate ────────────────────────────────────────
AFFILIATE_TAG=yourtag-20
MAX_RESULTS=5
# ── Scheduler ────────────────────────────────────────────────
DEFAULT_INTERVAL_MINUTES=30
AUTO_DISCOVER_ENABLED=false
AUTO_DISCOVER_HOUR=8
AUTO_ARTICLES_PER_DAY=5
AUTO_PUBLISH_MODE=false

# ── Anti-block Delays ────────────────────────────────────────
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# ── Test Mode (set to 1 for testing without publishing) ──────
TEST_MODE=0
