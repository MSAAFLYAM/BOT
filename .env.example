# .env.example -- Amazon Affiliate Bot
# Copy this to .env and fill in your real values.

# -- Telegram (REQUIRED) --
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=@your_channel_username
ADMIN_CHAT_ID=your_telegram_user_id

# -- Webhook Security --
WEBHOOK_SECRET=change_me_to_random_string

# -- AI (Groq free tier) --
GROQ_API_KEY=your_groq_api_key_here

# -- AI (OpenRouter, optional fallback) --
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# -- Blogger API --
BLOGGER_CLIENT_ID=your_client_id_here
BLOGGER_CLIENT_SECRET=your_client_secret_here
BLOGGER_REFRESH_TOKEN=your_refresh_token_here
BLOGGER_BLOG_ID=your_blog_id_here

# -- Image Processing --
REMOVEBG_API_KEY=
REPLICATE_API_TOKEN=
IMGBB_API_KEY=

# -- Image Transformation --
IMAGE_TRANSFORM_PRESET=auto
IMAGE_TRANSFORM_ENABLED=1

# -- Pinterest (optional) --
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD=Amazon Deals
PINTEREST_DAILY_CAP=5
PINTEREST_HOURS_AHEAD=4

# -- Amazon Affiliate --
AFFILIATE_TAG=dazzledeals00-20
MAX_RESULTS=5

# -- WordPress (optional) --
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# -- Auto-Discovery Scheduler --
# Set to "true" to enable fully automated publishing
AUTO_DISCOVER_ENABLED=false
# How often to run (in hours)
AUTO_DISCOVER_INTERVAL_HOURS=4
# How many articles per session
AUTO_ARTICLES_PER_RUN=3
# Max articles per day (never exceeds this)
AUTO_DAILY_MAX=10
# Keywords by category (JSON format)
# If empty, uses built-in default keywords
AUTO_KEYWORDS={"Home & Kitchen": ["air fryer", "robot vacuum", "instant pot", "coffee maker", "knife set", "stand mixer", "food storage containers", "electric kettle", "cast iron skillet", "blender"], "Beauty & Health": ["facial cleansing brush", "hair dryer", "electric toothbrush", "massage gun", "skincare fridge", "jade roller", "teeth whitening kit", "humidifier", "posture corrector", "foot spa"], "Sports & Outdoors": ["yoga mat", "resistance bands", "camping tent", "hydration backpack", "fitness tracker", "foldable bike", "insulated water bottle", "hiking boots", "portable grill", "sleeping bag"], "Tech & Gadgets": ["led strip lights", "portable charger", "bluetooth speaker", "wireless earbuds", "phone case", "laptop stand", "smart plug", "webcam", "mechanical keyboard", "tablet stand"]}

# -- Anti-block Delays --
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# -- Test Mode --
TEST_MODE=0

# -- Server --
PORT=8080
PUBLIC_DOMAIN=
